# Ambiente LOCAL (emuladores Firebase). `npm run setup` (na raiz do repo) copia
# este arquivo para .env.local. Valores fictícios: nunca tocam produção.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ipe.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ipe
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-ipe.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
