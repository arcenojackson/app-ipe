rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Professor, curador ou administrador
    function hasTeachingAccess() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('teaching_role', '') in ['teacher', 'curator']
      );
    }

    // Curador ou administrador
    function isCuratorOrAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('teaching_role', '') == 'curator'
      );
    }

    function allowedContentType() {
      return request.resource.contentType == 'application/pdf' ||
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType in [
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.oasis.opendocument.text',
          'application/vnd.oasis.opendocument.presentation',
          'application/vnd.oasis.opendocument.spreadsheet'
        ];
    }

    match /teaching/materials/{materialId}/{fileName} {
      allow read: if hasTeachingAccess();

      // 100 MB por arquivo. Qualquer professor cria arquivos novos.
      // O emulador avalia o envio sobre um objeto existente como `create`
      // (com `resource` preenchido); por isso, sobrescrever exige curador/admin
      // também aqui. Objeto novo (`resource == null`): qualquer professor.
      allow create: if hasTeachingAccess() &&
        (resource == null || isCuratorOrAdmin()) &&
        request.resource.size <= 100 * 1024 * 1024 &&
        allowedContentType();

      // Sobrescrever equivale a apagar: só curador/admin. A substituição pelo
      // autor virá com o controle de propriedade em etapa posterior.
      allow update: if isCuratorOrAdmin() &&
        request.resource.size <= 100 * 1024 * 1024 &&
        allowedContentType();

      allow delete: if isCuratorOrAdmin();
    }
  }
}
