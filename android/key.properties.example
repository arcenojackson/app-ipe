# Exemplo de arquivo key.properties
# 
# IMPORTANTE: Copie este arquivo para key.properties e preencha com seus dados reais
# NUNCA commite o arquivo key.properties no git!
#
# Como gerar a keystore:
# keytool -genkey -v -keystore ~/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storePassword=SUA_SENHA_DA_KEYSTORE_AQUI
keyPassword=SUA_SENHA_DO_ALIAS_AQUI
keyAlias=upload
storeFile=/caminho/para/sua/upload-keystore.jks

