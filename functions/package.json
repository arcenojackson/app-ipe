{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:integration": "firebase emulators:exec --only firestore --project demo-ipe-elections \"vitest run --config vitest.integration.config.mts\"",
    "test:emulator": "../rules-tests/node_modules/.bin/firebase emulators:exec --only firestore --project demo-ipe-rules \"vitest run --config vitest.emulator.config.ts\"",
    "backfill-claims": "tsx scripts/backfill-teaching-claims.ts",
    "backfill-claims:dry": "tsx scripts/backfill-teaching-claims.ts --dry-run",
    "seed-tags": "tsx scripts/seed-teaching-tags.ts",
    "seed-tags:dry": "tsx scripts/seed-teaching-tags.ts --dry-run",
    "seed-plan": "tsx scripts/seed-teaching-plan.ts",
    "seed-plan:dry": "tsx scripts/seed-teaching-plan.ts --dry-run",
    "backfill-approved-by": "tsx scripts/backfill-approved-by.ts --execute",
    "backfill-approved-by:dry": "tsx scripts/backfill-approved-by.ts",
    "purge-library": "tsx scripts/purge-teaching-library.ts --execute",
    "purge-library:dry": "tsx scripts/purge-teaching-library.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^14.27.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.4"
  },
  "private": true
}
